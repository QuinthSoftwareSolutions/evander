{
  "name": "evander-workflow-editor",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "test": "node --test --test-concurrency=1 --experimental-strip-types test/**/*.test.mjs",
    "test:smoke": "node --test --experimental-strip-types test/**/*.smoke.mjs",
    "build:team-org-flow": "vite build --config vite.team-org-flow.config.ts",
    "build:team-agent-create": "vite build --config vite.team-agent-create.config.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.462.0",
    "playwright": "^1.59.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3"
  }
}
