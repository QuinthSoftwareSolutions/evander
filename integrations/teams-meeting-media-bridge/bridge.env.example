# Operator-owned copy: literal KEY=value lines, no quoting or shell expansion.
BRIDGE_ADAPTER_MODE=Graph
BRIDGE_SPEECH_MODE=OpenAIRealtime
TEAMS_CALLS_ENABLED=false
TEAMS_BRIDGE_TOKEN=replace-with-bridge-secret
TEAMS_BOT_APP_ID=00000000-0000-4000-8000-000000000001
TEAMS_BOT_APP_SECRET=replace-with-app-secret
TEAMS_BOT_TENANT_ID=00000000-0000-4000-8000-000000000002
TEAMS_BOT_PUBLIC_CALLBACK_BASE_URL=https://bridge.example.test
TEAMS_BOT_SERVICE_FQDN=bridge.example.test
TEAMS_BOT_PUBLIC_IP=192.0.2.10
TEAMS_BOT_PUBLIC_PORT=8445
TEAMS_BOT_INTERNAL_PORT=8445
TEAMS_BOT_CERT_THUMBPRINT=replace-with-local-machine-certificate-thumbprint
VOICE_MEDIA_CONTROLLER_URL=https://control.example.test
VOICE_MEDIA_CONTROLLER_TOKEN=replace-with-root-controller-secret
OPENAI_REALTIME_API_KEY=replace-with-openai-key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
ASPNETCORE_URLS=https://+:443
# Also configure ASPNETCORE_Kestrel__Certificates__Default__Path and Password,
# or place an authenticated HTTPS reverse proxy in front of the HTTP listener.
# CertificateThumbprint above belongs to the Graph media platform, not Kestrel.
