[Unit]
Description=Agent Sandbox Container Worker Daemon
After=network-online.target docker.service
Wants=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User={{ agent_sandbox_run_user }}
{% if (agent_sandbox_run_user_supplementary_groups | default([]) | length) > 0 %}
SupplementaryGroups={{ agent_sandbox_run_user_supplementary_groups | join(' ') }}
{% endif %}
WorkingDirectory={{ agent_sandbox_deploy_path }}
EnvironmentFile={{ agent_sandbox_deploy_path }}/config/worker-daemon.env
ExecStart={{ agent_sandbox_deploy_path }}/.venv/bin/agent-sandbox-worker-daemon --host {{ agent_sandbox_worker_host }} --port {{ agent_sandbox_worker_port }} --runtime-dir {{ agent_sandbox_worker_runtime_dir }} --worker-root {{ agent_sandbox_worker_root }} --sandbox-profile {{ agent_sandbox_worker_sandbox_profile }}{% if (agent_sandbox_worker_docker_network | default('') | string | trim | length) > 0 %} --docker-network {{ agent_sandbox_worker_docker_network }}{% endif %}{% if agent_sandbox_worker_read_only_rootfs | bool %} --read-only-rootfs{% endif %}{% for tmpfs in agent_sandbox_worker_tmpfs %} --tmpfs {{ tmpfs }}{% endfor %}{% if (agent_sandbox_effective_worker_container_user | default('') | string | trim | length) > 0 %} --container-user {{ agent_sandbox_effective_worker_container_user }}{% endif %}{{ "" }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
