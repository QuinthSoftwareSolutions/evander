[Unit]
Description=Agent Sandbox Worker Container Egress Policy
After=docker.service
Requires=docker.service
Before=agent-sandbox-worker-daemon.service

[Service]
Type=oneshot
ExecStart={{ agent_sandbox_worker_egress_policy_script_path }} apply
ExecStop={{ agent_sandbox_worker_egress_policy_script_path }} clear
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
