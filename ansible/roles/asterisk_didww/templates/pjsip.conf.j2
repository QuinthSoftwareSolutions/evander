; Managed by agent-sandbox Ansible.
[global]
type=global
user_agent={{ agent_sandbox_asterisk_user_agent }}

[transport-udp]
type=transport
protocol=udp
bind={{ agent_sandbox_asterisk_sip_bind_host }}:{{ agent_sandbox_asterisk_sip_bind_port }}
external_signaling_address={{ agent_sandbox_asterisk_public_address }}
external_media_address={{ agent_sandbox_asterisk_public_address }}
{% for local_net in agent_sandbox_asterisk_local_nets %}
local_net={{ local_net }}
{% endfor %}

[{{ agent_sandbox_asterisk_didww_auth_section }}]
type=auth
auth_type=userpass
username={{ agent_sandbox_asterisk_didww_sip_username }}
password={{ agent_sandbox_asterisk_didww_sip_password }}

[{{ agent_sandbox_asterisk_didww_aor_section }}]
type=aor
contact=sip:{{ agent_sandbox_asterisk_didww_sip_host }}
qualify_frequency={{ agent_sandbox_asterisk_didww_qualify_frequency }}

[{{ agent_sandbox_asterisk_didww_endpoint }}]
type=endpoint
transport=transport-udp
context={{ agent_sandbox_asterisk_didww_context }}
disallow=all
allow={{ agent_sandbox_asterisk_didww_codecs | join(",") }}
outbound_auth={{ agent_sandbox_asterisk_didww_auth_section }}
aors={{ agent_sandbox_asterisk_didww_aor_section }}
direct_media=no
rewrite_contact=yes
force_rport=yes
rtp_symmetric=no
{% if agent_sandbox_asterisk_didww_from_domain | length > 0 %}
from_domain={{ agent_sandbox_asterisk_didww_from_domain }}
{% endif %}
{% if agent_sandbox_asterisk_didww_from_user | length > 0 %}
from_user={{ agent_sandbox_asterisk_didww_from_user }}
{% endif %}
{% if agent_sandbox_asterisk_didww_contact_user | length > 0 %}
contact_user={{ agent_sandbox_asterisk_didww_contact_user }}
{% endif %}

[{{ agent_sandbox_asterisk_didww_identify_section }}]
type=identify
endpoint={{ agent_sandbox_asterisk_didww_endpoint }}
{% for match in agent_sandbox_asterisk_didww_identify_matches %}
match={{ match }}
{% endfor %}
