[Unit]
Description=Agent Sandbox Nexus Package Cache
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ agent_sandbox_nexus_user }}
Group={{ agent_sandbox_nexus_group }}
WorkingDirectory={{ agent_sandbox_nexus_current_link }}
Environment=NEXUS_DATA={{ agent_sandbox_nexus_data_dir }}
ExecStart={{ agent_sandbox_nexus_current_link }}/bin/nexus run
Restart=on-failure
RestartSec=10
TimeoutStartSec=600
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
