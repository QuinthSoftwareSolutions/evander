---
# Put these values in operator-owned inventory outside the checkout for hosts
# that use Teams change notifications. Set that host's real public URL there.
evander_manage_teams_ingest_config: true
evander_teams_ingest_config:
  runtime_dir: "runtime"
  directories: []
  publish_trigger_events_directly: true
  poll_interval_seconds: 2
  jitter_seconds: 5
  backoff_seconds: 60
  max_concurrent_target_polls: 4
  target_backoff_initial_seconds: 60
  target_backoff_max_seconds: 900
  target_transient_backoff_initial_seconds: 5
  target_transient_backoff_max_seconds: 30
  change_notifications_enabled: true
  change_notification_public_base_url: "https://control-plane.example.test"
  change_notification_listener_host: "127.0.0.1"
  change_notification_listener_port: 11882
  change_notification_subscription_lifetime_hours: 48
  change_notification_renewal_margin_hours: 24
  change_notification_reconciliation_poll_interval_seconds: 60
  lock_path: null
