[Unit]
Description=Evander Teams Graph Notifications Listener
After=network-online.target evander-teams-ingest.service
Wants=network-online.target
PartOf=evander-teams-ingest.service

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=TEAMS_NOTIFICATIONS_LOG_LEVEL=INFO
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/evander-teams-notifications --runtime-dir __PROJECT_DIR__/runtime --log-level ${TEAMS_NOTIFICATIONS_LOG_LEVEL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
