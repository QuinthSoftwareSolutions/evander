[
  {
    "id": "render",
    "display_name": "Render progress",
    "type": "effect:teams:render-progress-image",
    "config": {
      "session_id": {"$ref": "state.coordinator_session_id"},
      "snapshot": {"$ref": "state.progress_snapshot"}
    }
  },
  {
    "id": "post",
    "display_name": "Post progress once",
    "type": "effect:teams:post-file",
    "config": {
      "session_id": {"$ref": "state.coordinator_session_id"},
      "channel_target": "example-team/example-channel",
      "thread_id": {"$ref": "state.root_message_id"},
      "message": {"$ref": "nodes.render.status_text"},
      "artifact_ids": [{"$ref": "nodes.render.artifact_id"}],
      "editable_image_artifact_id": {"$ref": "nodes.render.artifact_id"},
      "idempotency_key": {"$ref": "state.progress_creation_key"}
    }
  },
  {
    "id": "update",
    "display_name": "Update existing progress",
    "type": "effect:teams:update-message",
    "config": {
      "session_id": {"$ref": "state.coordinator_session_id"},
      "channel_target": "example-team/example-channel",
      "thread_id": {"$ref": "state.root_message_id"},
      "message_id": {"$ref": "state.progress_message_id"},
      "expected_revision": {"$ref": "state.progress_message_revision"},
      "message": {"$ref": "nodes.render.status_text"},
      "image_artifact_id": {"$ref": "nodes.render.artifact_id"}
    }
  },
  {
    "id": "sync",
    "display_name": "Maintain one progress message",
    "type": "effect:teams:sync-progress-message",
    "config": {
      "enabled": false,
      "session_id": {"$ref": "state.coordinator_session_id"},
      "channel_target": "example-team/example-channel",
      "thread_id": {"$ref": "state.root_message_id"},
      "snapshot": {"$ref": "state.progress_snapshot"}
    }
  },
  {
    "id": "renew",
    "display_name": "Renew current progress image",
    "type": "effect:teams:sync-progress-message",
    "config": {
      "enabled": false,
      "session_id": {"$ref": "event.payload.session_id"},
      "channel_target": {"$ref": "event.payload.channel_target"},
      "thread_id": {"$ref": "event.payload.thread_id"},
      "generation_id": {"$ref": "event.payload.generation_id"},
      "outline_sha256": {"$ref": "event.payload.outline_sha256"},
      "source_version": {"$ref": "event.payload.source_version"},
      "action": {"$ref": "event.payload.action"}
    }
  }
]
