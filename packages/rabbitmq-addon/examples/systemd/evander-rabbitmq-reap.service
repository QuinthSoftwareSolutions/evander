[Unit]
Description=Reconcile expired Evander RabbitMQ resources
[Service]
Type=oneshot
ExecStart=/opt/evander-worker/.venv/bin/evander-rabbitmq-worker --config /etc/evander-rabbitmq/worker.json --reap
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/evander-rabbitmq-addon /var/lib/agent-worker/runtime
EnvironmentFile=/etc/evander-rabbitmq/worker.env
