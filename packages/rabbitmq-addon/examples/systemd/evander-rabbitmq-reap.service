[Unit]
Description=Reconcile expired Evander RabbitMQ resources
[Service]
Type=simple
ExecStart=/opt/evander-worker/.venv/bin/evander-rabbitmq-worker --config /etc/evander-rabbitmq/worker.json --reap-loop
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/evander-rabbitmq-addon /var/lib/agent-worker/runtime
EnvironmentFile=/etc/evander-rabbitmq/worker.env

[Install]
WantedBy=multi-user.target
