[Unit]
Description=Evander RabbitMQ resource worker
After=network-online.target docker.service
[Service]
Type=simple
ExecStart=/opt/evander-worker/.venv/bin/evander-rabbitmq-worker --config /etc/evander-rabbitmq/worker.json --host 127.0.0.1 --port 11993
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/evander-rabbitmq-addon /var/lib/agent-worker/runtime
EnvironmentFile=/etc/evander-rabbitmq/worker.env
Restart=on-failure
RestartSec=3
[Install]
WantedBy=multi-user.target
