[Unit]
Description=Reconcile expired test fixtures and recover broker faults
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=/etc/evander-test-fixtures/worker.env
ExecStart=/opt/evander-worker/.venv/bin/evander-test-fixtures-worker --config /etc/evander-test-fixtures/worker.json --reap
TimeoutStartSec=180
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
# SQLite can spill worker-job queries to temporary files.
PrivateTmp=yes
ReadWritePaths=/var/lib/evander-test-fixtures /var/lib/agent-worker/runtime
