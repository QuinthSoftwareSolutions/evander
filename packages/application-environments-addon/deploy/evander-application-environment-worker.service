[Unit]
Description=Evander private application environment supervisor
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/evander
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=/etc/evander/application-worker.env
ExecStart=/opt/evander/.venv/bin/evander-application-environment-worker --config /etc/evander/application-worker.json --host 127.0.0.1 --port 11893
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
