{
  "description": "Share an existing approved external application; no hosted application environment is created.",
  "nodes": [
    {
      "id": "browser",
      "display_name": "Share test browser",
      "type": "effect:browser-session:ensure",
      "config": {
        "agent_session_id": "${{request.payload.agent_session_id}}",
        "request": {
          "mode": "hosted",
          "request_id": "${{request.event_id}}",
          "profile_id": "browser",
          "target_aliases": [
            "test-ui",
            "test-api"
          ],
          "entry_url": "https://test.example.test/"
        }
      }
    }
  ]
}
