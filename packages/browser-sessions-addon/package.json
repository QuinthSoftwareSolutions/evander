{
  "name": "evander-browser-sessions",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/build.mjs && node --test --test-timeout=45000 test/*.test.mjs",
    "test:browser": "node scripts/build.mjs && mkdir -p test-output && node --test --test-concurrency=1 --test-timeout=60000 test/*.browser.mjs",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "playwright": "1.59.1",
    "typescript": "5.9.3",
    "@types/node": "22.15.3"
  }
}
