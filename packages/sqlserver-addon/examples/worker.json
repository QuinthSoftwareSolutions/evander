          "password_env": "EXAMPLE_SQL_READ_PASSWORD"
        },
        "write": {
          "username_env": "EXAMPLE_SQL_WRITE_USER",
          "password_env": "EXAMPLE_SQL_WRITE_PASSWORD"
        }
      },
      "operations": []
    }
