[Unit]
Description=Reconcile expired Evander SQL Server resources
[Service]
Type=oneshot
ExecStart=/opt/evander-worker/.venv/bin/evander-sqlserver-worker --config /etc/evander-sqlserver/worker.json --reap
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/evander-sqlserver-addon /var/lib/agent-worker/runtime
EnvironmentFile=/etc/evander-sqlserver/worker.env
