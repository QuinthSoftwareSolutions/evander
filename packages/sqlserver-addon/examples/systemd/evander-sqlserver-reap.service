[Unit]
Description=Reconcile expired Evander SQL Server resources
[Service]
Type=simple
ExecStart=/opt/evander-worker/.venv/bin/evander-sqlserver-worker --config /etc/evander-sqlserver/worker.json --reap-loop
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
User=root
Group=root
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/evander-sqlserver-addon /var/lib/agent-worker/runtime
EnvironmentFile=/etc/evander-sqlserver/worker.env

[Install]
WantedBy=multi-user.target
