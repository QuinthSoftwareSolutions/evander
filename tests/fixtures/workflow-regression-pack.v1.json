                "equals": "provision_exampleindustry_app_demo_environment.sh"
              }
            ]
          }
        },
        "id": "gate-filter-5",
        "type": "gate:filter"
      },
      {
        "config": {
          "args": [
            "--resource-base-name",
            "${{gate-filter-5.parameters.0}}"
          ],
          "script_path": "/opt/agent-sandbox/scripts/provision_exampleindustry_app_demo_environment.sh"
        },
        "id": "effect-bash-script-1",
        "outputs": {
          "app_api_alias": {
            "type": "string"
          },
          "app_base_url": {
            "type": "string"
          },
          "app_public_url": {
            "type": "string"
          },
          "app_ui_alias": {
            "type": "string"
          },
          "session_metadata_patch": {
            "type": "object"
          }
        },
        "type": "effect:bash:script"
      },
      {
        "config": {
          "metadata": "${{effect-bash-script-1.session_metadata_patch}}"
        },
        "id": "effect-session-update-metadata-6",
