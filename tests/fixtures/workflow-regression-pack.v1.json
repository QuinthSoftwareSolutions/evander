                      "pipeline_run_id": "${{effect-ado-pipeline-run-1.run_id}}",
                      "pipeline_run_url": "${{effect-ado-pipeline-run-1.run_url ?? null}}",
                      "role": "api"
                    }
                  },
                  "${{gate-filter-5.parameters.0}}-ui": {
                    "base_url": "https://${{gate-filter-5.parameters.0}}.northeurope.cloudapp.azure.com",
                    "metadata": {
                      "kind": "exampleindustry_app_demo_environment",
                      "environment_alias": "${{gate-filter-5.parameters.0}}",
                      "api_alias": "${{gate-filter-5.parameters.0}}-api",
                      "ui_alias": "${{gate-filter-5.parameters.0}}-ui",
