        "outputs": {
          "parameters": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "request_id": {
            "type": "string"
          },
          "script_name": {
            "type": "string"
          },
          "session_id": {
            "type": "string"
          }
        },
        "type": "trigger:script-run-request"
