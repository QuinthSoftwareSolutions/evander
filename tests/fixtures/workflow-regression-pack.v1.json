        "id": "effect-agent-copy-files-5",
        "type": "effect:agent:copy-files"
      },
      {
        "config": {
          "command": "bash .agent-sandbox/bin/setup_review_repo.sh --base-ref refs/heads/${{trigger-review-new-request-1.review_request.base_branch}} --head-ref refs/heads/${{trigger-review-new-request-1.review_request.head_branch}} --base-commit \"${{trigger-review-new-request-1.review_request.base_commit ?? \"\"}}\" --head-commit \"${{trigger-review-new-request-1.review_request.head_commit ?? \"\"}}\"",
          "target": "${{effect-agent-clone-repo-2.session_id}}",
