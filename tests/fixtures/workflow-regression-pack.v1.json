      {
        "config": {
          "prompt": "APP API alias: ${{effect-bash-script-1.app_api_alias}}\nAPP UI alias: ${{effect-bash-script-1.app_ui_alias}}\nAPP API base URL: ${{effect-bash-script-1.app_base_url}}\nPublic UI URL: ${{effect-bash-script-1.app_public_url}}\nUI relay URL: $HTTP_TARGET_RELAY_BASE_URL/session/${{gate-filter-5.session_id}}/target/${{effect-bash-script-1.app_ui_alias}}/\nAPI relay URL: $HTTP_TARGET_RELAY_BASE_URL/session/${{gate-filter-5.session_id}}/target/${{effect-bash-script-1.app_api_alias}}/",
          "resume_thread_id": "${{query-session-context-4.metadata.agent_thread_id ?? null}}"
        },
        "id": "effect-agent-prompt-9",
        "type": "effect:agent:prompt"
      },
      {
        "config": {
          "files": [
            {
              "destination_path": "${{effect-agent-clone-repo-2.target_dir}}/.agent-sandbox/bin/setup_review_repo.sh",
