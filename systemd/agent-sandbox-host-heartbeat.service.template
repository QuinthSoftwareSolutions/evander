[Unit]
Description=Agent Sandbox Host Heartbeat Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/config/host-heartbeat.env
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/scripts/run_host_heartbeat.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
