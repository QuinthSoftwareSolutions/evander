[Unit]
Description=Agent Sandbox Host Heartbeat Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/config/host-heartbeat.env
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-cli host-heartbeat --config ${AGENT_SANDBOX_CONFIG:-config/gateway.yaml} --log-level ${HOST_HEARTBEAT_LOG_LEVEL:-INFO}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
