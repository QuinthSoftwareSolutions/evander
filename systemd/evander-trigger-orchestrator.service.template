[Unit]
Description=Evander Trigger Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=TRIGGER_ORCHESTRATOR_LOG_LEVEL=INFO
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/evander-cli trigger-orchestrator --runtime-dir __PROJECT_DIR__/runtime --log-level ${TRIGGER_ORCHESTRATOR_LOG_LEVEL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
