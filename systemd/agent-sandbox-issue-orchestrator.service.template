[Unit]
Description=Agent Sandbox Issue Orchestrator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-issue-orchestrator --log-level ${ISSUE_ORCHESTRATOR_LOG_LEVEL:-INFO}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
