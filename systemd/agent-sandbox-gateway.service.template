[Unit]
Description=Agent Sandbox MCP Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/config/gateway.env
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-gateway
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
