[Unit]
Description=Evander Scheduled Wake Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/secrets.env
Environment=SCHEDULED_WAKE_LOG_LEVEL=INFO
ExecStart=__PROJECT_DIR__/.venv/bin/evander-scheduled-wake --runtime-dir __PROJECT_DIR__/runtime --log-level ${SCHEDULED_WAKE_LOG_LEVEL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
