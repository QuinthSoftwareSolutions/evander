[Unit]
Description=Agent Sandbox OpenAI Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/config/openai-relay.env
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-openai-relay --config ${AGENT_SANDBOX_CONFIG}
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
