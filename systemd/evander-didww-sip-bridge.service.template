[Unit]
Description=Evander DIDWW SIP/OpenAI Realtime Bridge
After=network-online.target asterisk.service
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/config/didww-sip-bridge.env
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/evander-didww-sip-bridge --runtime-dir __PROJECT_DIR__/runtime
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
