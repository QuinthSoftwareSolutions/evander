[Unit]
Description=Evander npm Audit Facade
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/config/npm-audit-facade.env
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/evander-npm-audit-facade
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
