[Unit]
Description=Agent Sandbox NuGet Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/config/nuget-relay.env
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-nuget-relay
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
