[Unit]
Description=Evander Teams Ingest Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=TEAMS_INGEST_LOG_LEVEL=INFO
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/scripts/run_teams_ingest.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
