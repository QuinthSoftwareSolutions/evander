[Unit]
Description=Agent Sandbox Azure DevOps Backlog Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=__PROJECT_DIR__/config/ado-worker.env
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-ado-worker --log-level ${ADO_WORKER_LOG_LEVEL:-INFO}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
