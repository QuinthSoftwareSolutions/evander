[Unit]
Description=Agent Sandbox Azure DevOps Backlog Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=ADO_WORKER_LOG_LEVEL=INFO
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-ado-worker --log-level ${ADO_WORKER_LOG_LEVEL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
