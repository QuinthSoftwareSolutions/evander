[Unit]
Description=Agent Sandbox Discord Wake Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/secrets.env
Environment=DISCORD_WAKE_LOG_LEVEL=INFO
ExecStart=__PROJECT_DIR__/.venv/bin/agent-sandbox-discord-wake --runtime-dir __PROJECT_DIR__/runtime --log-level ${DISCORD_WAKE_LOG_LEVEL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
