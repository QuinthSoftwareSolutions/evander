[Unit]
Description=Evander Teams Meeting Ingest Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=TEAMS_MEETING_INGEST_LOG_LEVEL=INFO
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/evander-teams-meeting-ingest --runtime-dir __PROJECT_DIR__/runtime --log-level ${TEAMS_MEETING_INGEST_LOG_LEVEL}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
