[Unit]
Description=Evander NuGet Relay
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RUN_USER__
WorkingDirectory=__PROJECT_DIR__
EnvironmentFile=-__PROJECT_DIR__/config/nuget-relay.env
EnvironmentFile=-__PROJECT_DIR__/secrets.env
ExecStart=__PROJECT_DIR__/.venv/bin/evander-nuget-relay
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
