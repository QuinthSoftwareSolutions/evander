#!/usr/bin/env bash
set -euo pipefail

show_help() {
  cat <<'EOH'
Usage: scripts/setup [OPTIONS] [-- EVANDER_CLI_SETUP_ARGS...]

Bootstrap this checkout, install Evander into a repo-local virtual environment,
then launch the guided setup checklist.

Options:
  --bootstrap-only  Create/update .venv and install Evander, then stop.
  --dev             Install editable development extras with '.[dev]'.
  --python PATH     Python interpreter to use when creating .venv. Default: python3.
  --venv DIR        Virtual environment path. Default: .venv.
  --skip-apt        Do not install OS Python bootstrap packages.
  -h, --help        Show this help text.

Environment:
  EVANDER_SETUP_BOOTSTRAP_ONLY=1  Same as --bootstrap-only.
  EVANDER_SETUP_SKIP_APT=1        Same as --skip-apt.
  EVANDER_SETUP_SKIP_PIP=1        Skip the editable pip install.
  EVANDER_SETUP_PRIVILEGE_CMD     Privilege command for apt, e.g. "sudo" or "pkexec".
  EVANDER_SETUP_PYTHON            Python interpreter override.
  EVANDER_SETUP_VENV_DIR          Virtual environment path override.

Examples:
  ./scripts/setup
  ./scripts/setup --dev --bootstrap-only
  ./scripts/setup -- --runtime-dir runtime
EOH
}

log() {
  printf '[setup] %s\n' "$*"
}

die() {
  printf '[setup] ERROR: %s\n' "$*" >&2
  exit 1
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

PYTHON_BIN="${EVANDER_SETUP_PYTHON:-python3}"
VENV_DIR="${EVANDER_SETUP_VENV_DIR:-${ROOT_DIR}/.venv}"
BOOTSTRAP_ONLY="${EVANDER_SETUP_BOOTSTRAP_ONLY:-0}"
SKIP_APT="${EVANDER_SETUP_SKIP_APT:-0}"
SKIP_PIP="${EVANDER_SETUP_SKIP_PIP:-0}"
DEV_INSTALL=0
SETUP_ARGS=()
PRIVILEGE_CMD_RESOLVED=0
PRIVILEGE_CMD=()

while [[ $# -gt 0 ]]; do
  case "$1" in
    --bootstrap-only|--no-setup)
      BOOTSTRAP_ONLY=1
      shift
      ;;
    --dev)
      DEV_INSTALL=1
      shift
      ;;
    --python)
      [[ $# -ge 2 ]] || die "--python requires a value."
      PYTHON_BIN="$2"
      shift 2
      ;;
    --venv)
      [[ $# -ge 2 ]] || die "--venv requires a value."
      VENV_DIR="$2"
      shift 2
      ;;
    --skip-apt)
      SKIP_APT=1
      shift
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    --)
      shift
      SETUP_ARGS=("$@")
      break
      ;;
    *)
      die "Unknown argument: $1"
      ;;
  esac
done

if [[ "${VENV_DIR}" != /* ]]; then
  VENV_DIR="${ROOT_DIR}/${VENV_DIR}"
fi

resolve_privilege_cmd() {
  if [[ "${PRIVILEGE_CMD_RESOLVED}" == "1" ]]; then
    return
  fi
  PRIVILEGE_CMD_RESOLVED=1

  if [[ "$(id -u)" -eq 0 ]]; then
    PRIVILEGE_CMD=()
  elif [[ -n "${EVANDER_SETUP_PRIVILEGE_CMD:-}" ]]; then
    # shellcheck disable=SC2206
    PRIVILEGE_CMD=(${EVANDER_SETUP_PRIVILEGE_CMD})
  elif command -v sudo >/dev/null 2>&1; then
    PRIVILEGE_CMD=(sudo)
  elif command -v pkexec >/dev/null 2>&1; then
    PRIVILEGE_CMD=(pkexec)
  else
    die "Missing sudo or pkexec; install python3-venv and python3-pip manually, then rerun."
  fi
}

run_privileged() {
  resolve_privilege_cmd
  "${PRIVILEGE_CMD[@]}" "$@"
}

python_can_create_venv() {
  command -v "${PYTHON_BIN}" >/dev/null 2>&1 || return 1

  local probe_root
  probe_root="$(mktemp -d)"
  if "${PYTHON_BIN}" -m venv "${probe_root}/venv" >/dev/null 2>&1; then
    rm -rf "${probe_root}"
    return 0
  fi
  rm -rf "${probe_root}"
  return 1
}

ensure_python_bootstrap_packages() {
  if [[ -x "${VENV_DIR}/bin/python" ]]; then
    return
  fi
  if python_can_create_venv; then
    return
  fi
  if [[ "${SKIP_APT}" == "1" ]]; then
    die "${PYTHON_BIN} cannot create a virtual environment. Install python3-venv and rerun."
  fi
  if ! command -v apt-get >/dev/null 2>&1; then
    die "Automatic OS package install currently supports apt-get hosts only."
  fi

  log "Installing Python bootstrap packages with apt."
  run_privileged apt-get update
  run_privileged apt-get install -y python3 python3-venv python3-pip
  python_can_create_venv || die "${PYTHON_BIN} still cannot create a virtual environment."
}

create_or_reuse_venv() {
  if [[ -x "${VENV_DIR}/bin/python" ]]; then
    log "Using existing virtual environment: ${VENV_DIR}"
    return
  fi
  log "Creating virtual environment: ${VENV_DIR}"
  "${PYTHON_BIN}" -m venv "${VENV_DIR}"
}

ensure_pip() {
  if "${VENV_DIR}/bin/python" -m pip --version >/dev/null 2>&1; then
    return
  fi
  log "Bootstrapping pip inside ${VENV_DIR}"
  "${VENV_DIR}/bin/python" -m ensurepip --upgrade
}

install_evander() {
  if [[ "${SKIP_PIP}" == "1" ]]; then
    log "Skipping editable install because EVANDER_SETUP_SKIP_PIP=1."
    return
  fi

  local install_spec="."
  if [[ "${DEV_INSTALL}" == "1" ]]; then
    install_spec=".[dev]"
  fi

  log "Installing Evander into ${VENV_DIR} with pip install -e '${install_spec}'."
  (
    cd "${ROOT_DIR}"
    "${VENV_DIR}/bin/python" -m pip install -e "${install_spec}"
  )
}

launch_setup() {
  local evander_cli="${VENV_DIR}/bin/evander-cli"
  [[ -x "${evander_cli}" ]] || die "Expected ${evander_cli} after install, but it is missing."

  if [[ "${BOOTSTRAP_ONLY}" == "1" ]]; then
    log "Bootstrap complete. Run ${evander_cli} setup when ready."
    return
  fi

  log "Starting guided setup."
  exec "${evander_cli}" setup "${SETUP_ARGS[@]}"
}

cd "${ROOT_DIR}"
ensure_python_bootstrap_packages
create_or_reuse_venv
ensure_pip
install_evander
launch_setup
