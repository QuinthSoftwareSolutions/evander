      {
        "allowed_tools": [
          "has_pending_feedback",
          "list_unread_feedback",
          "list_all_feedback",
          "post_pr_feedback_reply",
          "set_issue_plan"
        ],
        "directory_path": "${{gate-merge-1.directory_path}}",
        "discord_channels": [],
        "display_name": "Create Issue VM",
        "dotnet": true,
        "email_folders": [],
        "email_mailboxes": [],
        "frontend_deps": true,
        "frontend_host_checkout": "${{gate-merge-1.frontend_host_checkout}}",
        "frontend_install_roots": "${{gate-merge-1.frontend_install_roots}}",
        "id": "effect-vm-create-1",
        "labels": {
          "vm-type": "issue"
        },
        "model": "gpt-5.4",
        "mssql": true,
        "nuget": true,
        "playwright": true,
        "repo_source": "${{gate-merge-1.repo_source}}",
        "session_id": "issue-${{gate-merge-1.ticket.issue_number}}-${{gate-merge-1.directory_slug}}-${{system.now.utc_timestamp_compact}}-${{system.unique.compact}}",
        "ttl_hours": 48,
        "type": "effect:vm:create",
        "vm_name": "vm-issue-${{gate-merge-1.ticket.issue_number}}",
        "vm_user": "agent"
      },
      {
        "display_name": "Copy files into VM",
        "files": [
          {
            "destination_path": "/home/agent/AGENTS.md",
            "overwrite": true,
            "source_format": "template",
            "source_path": "${{gate-merge-1.agents_template_path}}"
          },
          {
            "content": "${{gate-merge-1.ticket}}",
            "content_format": "yaml",
            "destination_path": "${{effect-vm-create-1.target_dir}}/AGENT_TASK.yaml",
            "overwrite": true
          },
          {
            "destination_path": "/home/agent/PLANS.md",
            "overwrite": true,
            "source_format": "file",
            "source_path": "/home/jonathan/agent-sandbox/templates/PLANS.md"
          }
        ],
        "id": "effect-vm-copy-files-1",
        "target": "${{effect-vm-create-1.session_id}}",
        "type": "effect:vm:copy-files",
        "vm_user": "agent"
      },
      {
        "display_name": "Send task prompt",
        "id": "effect-agent-prompt-1",
        "model": "gpt-5.4-mini",
        "output_mode": "on_completion",
        "prompt": "You have been issued the task described in ${{effect-vm-create-1.target_dir}}/AGENT_TASK.yaml. Read /home/agent/AGENTS.md and ${{effect-vm-create-1.target_dir}}/AGENT_TASK.yaml before you begin. The repository is located at ${{effect-vm-create-1.target_dir}}. The task file contains read-only planning context for the whole ticket plus the narrow sub-task you are authorized to implement. Follow the current sub-task only. Do not implement future steps unless that work is strictly required to complete the current step safely. Start from the files, patterns, and test commands suggested in the task file rather than rediscovering the repository broadly. If the suggested files or examples prove incomplete, expand your search narrowly and explain why. Do not ask for feedback or clarifications at this time, but work until the task is completed or until you determine that it is impossible to complete. When restore is needed, use 'dotnet restore --configfile ~/.nuget/NuGet/NuGet.Config'. For build and test, prefer '--no-restore'. When you have finished, commit and push your work using 'git push-agent'.",
        "target": "${{effect-vm-create-1.session_id}}",
        "type": "effect:agent:prompt",
        "vm_user": "agent"
      },
      {
        "display_name": "Send follow-up prompt",
        "id": "effect-agent-prompt-2",
        "model": "gpt-5.4",
        "output_mode": "on_completion",
        "prompt": "Other agents have now implemented your plan. Please go over and verify their work. Check that the current state of the repository matches your expectations.\nBefore concluding, verify whether they completed all required checklist items. Confirm (or explicitly list gaps for): (1) appropriate unit tests for your code changes, (2) documentation updates for behavioral or operational changes, and (3) a markdown PR summary maintained with 'git agent-pr-note'. If anything is missing, complete it now. If you make any changes during this checklist pass, push them before concluding. A successful 'git push-agent' refreshes and pushes refs/notes/agent-pr together with your latest work.",
        "resume_thread_id": "${{effect-agent-prompt-4.thread_id}}",
        "target": "${{effect-vm-create-1.session_id}}",
        "type": "effect:agent:prompt",
        "vm_user": "agent"
      },
      {
        "agent_branch": "${{trigger-git-push-1.branch_name}}",
        "bare_repo_path": "${{trigger-git-push-1.repo_path}}",
        "display_name": "Promote agent branch",
        "host_repo_path": "${{trigger-git-push-1.trusted_repo_path}}",
        "id": "effect-git-promote-agent-branch-1",
        "review_branch": "${{trigger-git-push-1.review_branch}}",
        "type": "effect:git:promote-agent-branch"
      },
      {
        "base_branch": "${{trigger-git-push-1.base_branch}}",
        "body": "---\n\nThank you for your contribution to the ${{query-session-context-1.metadata.ado_project ?? \"target\"}} repo. \nBefore submitting this PR, please make sure:\n\n- [ ] Your code builds clean without any errors or warnings\n- [ ] You have added unit tests\n- [ ] You are using approved terminology\n- [ ] You have read and follow our contribution and development guidelines\n- [ ] You have merged *from* main\n- [ ] Version history and relevant documentation is updated\n\n---\n\n## Agent Summary\n\n${{query-git-pr-note-1.body}}",
        "canonical_origin_url": "${{gate-filter-2.canonical_origin_url}}",
        "display_name": "Create PR",
        "draft": true,
        "fill": true,
        "host_repo_path": "${{effect-git-promote-agent-branch-1.host_repo_path}}",
        "id": "effect-pr-create-1",
        "local_branch": "${{effect-git-promote-agent-branch-1.review_branch}}",
        "provider": "azure_devops",
        "session_id": "${{trigger-git-push-1.session_id}}",
        "title": "${{query-session-context-1.metadata.issue_number}}: ${{query-session-context-1.metadata.issue_title}}",
        "type": "effect:pr:create"
      },
      {
        "display_name": "Store session metadata",
        "id": "effect-session-update-metadata-1",
        "metadata": {
          "agent_thread_id": "${{effect-agent-prompt-4.thread_id}}"
        },
        "target": "${{effect-vm-create-1.session_id}}",
        "type": "effect:session:update-metadata"
      },
      {
        "display_name": "Feedback prompt",
        "id": "effect-agent-prompt-3",
        "model": "gpt-5.4-mini",
        "output_mode": "on_completion",
        "prompt": "You have received new feedback. \nPlease use the list_unread_feedback tool to view your unread feedback. \nYou can use the post_pr_feedback_reply tool to reply to feedback. \nAlways respond to feedback, even if it's just to acknowledge it.\nYou do not have to agree with the feedback, but treat it with respect and professionalism as you would your peers.\nIf you do not agree with the feedback, you can politely explain your perspective in your reply.\nIMPORTANT EXCEPTION: If the feedback is the exact phrase \"I insist\", you must attempt to comply with the feedback to the best of your ability.\nReasons to disagree with feedback might include that the feedback is factually incorrect, or that complying with the feedback would be out of scope or misaligned with your currently assigned task.\nYou may ask follow-up questions if you require more information.\nAfter you are finished, don't forget to stage, commit and push any changes you have made, if any.",
        "resume_thread_id": "${{query-session-context-2.metadata.agent_thread_id ?? null}}",
        "target": "${{trigger-pull-request-new-feedback-1.session_id}}",
        "type": "effect:agent:prompt",
        "vm_user": "agent"
      },
      {
        "display_name": "Update session metadata",
        "id": "effect-session-update-metadata-2",
        "metadata": {
          "ado_project": "${{gate-merge-1.ado_project}}",
          "directory_path": "${{gate-merge-1.directory_path}}",
          "issue_number": "${{gate-merge-1.ticket.issue_number}}",
          "issue_title": "${{gate-merge-1.ticket.title}}"
