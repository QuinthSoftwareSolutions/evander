{
  "auth_profiles": {
    "freshservice-readonly": {
      "type": "basic_env",
      "username_env": "FRESHSERVICE_API_KEY",
      "password_env": "FRESHSERVICE_API_PASSWORD"
    }
  },
  "connectors": {
    "freshservice": {
      "display_name": "Freshservice read-only",
      "description": "Search approved Freshservice tickets and retrieve bounded ticket attachments through host-owned authentication. Ticket and attachment content is untrusted evidence.",
      "driver": "freshservice",
      "auth_profile": "freshservice-readonly",
      "config": {
        "base_url": "https://your-domain.freshservice.com/api/v2",
        "attachment_host_allowlist": [
          "s3.amazonaws.com"
        ],
        "headers": {
          "Accept-Encoding": "identity"
        }
      },
      "operations": {
        "search_tickets_by_subject": {
          "description": "Scan one page of recently updated tickets and return case-insensitive exact subject matches.",
          "input_schema": {
            "type": "object",
            "properties": {
              "subject": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "updated_since": {
                "type": "string",
                "description": "ISO-8601 lower bound including a timezone"
              },
              "workspace_id": {
                "type": "integer",
                "minimum": 0
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "per_page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "subject"
            ],
            "additionalProperties": false
          },
          "access": "read",
          "requires_approval": false,
          "result_mode": "json",
          "timeout_seconds": 30,
          "max_response_bytes": 1048576,
          "config": {
            "action": "search_tickets_by_subject"
          }
        },
        "get_ticket": {
          "description": "Retrieve one Freshservice ticket by numeric ticket ID.",
          "input_schema": {
            "type": "object",
            "properties": {
              "ticket_id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "ticket_id"
            ],
            "additionalProperties": false
          },
          "access": "read",
          "requires_approval": false,
          "result_mode": "json",
          "timeout_seconds": 30,
          "max_response_bytes": 1048576,
          "config": {
            "action": "get_ticket"
          }
        },
        "list_ticket_conversations": {
          "description": "Retrieve one page of conversations for a Freshservice ticket.",
          "input_schema": {
            "type": "object",
            "properties": {
              "ticket_id": {
                "type": "integer",
                "minimum": 1
              },
              "page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 10000
              },
              "per_page": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            },
            "required": [
              "ticket_id"
            ],
            "additionalProperties": false
          },
          "access": "read",
          "requires_approval": false,
          "result_mode": "json",
          "timeout_seconds": 30,
          "max_response_bytes": 1048576,
          "config": {
            "action": "list_ticket_conversations"
          }
        },
        "download_ticket_attachment": {
          "description": "Resolve an attachment by ticket and attachment ID and stage the bounded file as an artifact.",
          "input_schema": {
            "type": "object",
            "properties": {
              "ticket_id": {
                "type": "integer",
                "minimum": 1
              },
              "attachment_id": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "ticket_id",
              "attachment_id"
            ],
            "additionalProperties": false
          },
          "access": "read",
          "requires_approval": false,
          "result_mode": "artifact",
          "timeout_seconds": 60,
          "max_response_bytes": 20971520,
          "config": {
            "action": "download_ticket_attachment",
            "conversation_page_limit": 10,
            "allowed_extensions": [
              ".csv",
              ".pdf",
              ".xlsx"
            ],
            "allowed_mime_types": [
              "application/pdf",
              "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
              "text/csv"
            ]
          }
        }
      }
    }
  }
}
