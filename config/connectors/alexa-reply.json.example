{
  "auth_profiles": {
    "alexa-reply-callback": {
      "type": "bearer_env",
      "token_env": "ALEXA_REPLY_CALLBACK_TOKEN"
    }
  },
  "connectors": {
    "alexa-reply": {
      "display_name": "Alexa reply mailbox",
      "description": "Submit the final answer for one authenticated Alexa request.",
      "driver": "rest",
      "auth_profile": "alexa-reply-callback",
      "config": {
        "base_url": "https://REPLACE_WITH_API_ID.execute-api.eu-north-1.amazonaws.com/v1"
      },
      "operations": {
        "submit": {
          "description": "Submit one completed or failed Alexa reply by immutable request ID.",
          "input_schema": {
            "type": "object",
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "request_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,128}$"
                  },
                  "status": {
                    "type": "string",
                    "enum": ["completed", "failed"]
                  },
                  "reply": {
                    "type": "string",
                    "maxLength": 12000
                  },
                  "error": {
                    "type": "string",
                    "maxLength": 1000
                  }
                },
                "required": ["request_id", "status"],
                "additionalProperties": false
              }
            },
            "required": ["payload"],
            "additionalProperties": false
          },
          "access": "write",
          "requires_approval": false,
          "result_mode": "json",
          "timeout_seconds": 10,
          "max_response_bytes": 65536,
          "config": {
            "method": "POST",
            "path": "/replies",
            "json_body_argument": "payload"
          }
        }
      }
    }
  }
}
