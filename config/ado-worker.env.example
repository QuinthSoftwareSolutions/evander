# Azure DevOps worker compatibility configuration.

# Azure DevOps org/project settings come from runtime directory config rooted at `root`
# (including any root-level provider overrides).
# The ADO worker now owns PR feedback/completion polling only. Work-item intake belongs to
# workflow nodes: trigger:ado:work-item-matching, query:ado:work-items, and
# effect:issue:upsert-ado-proxy.

# Polling cadence and optional scope filters.
ADO_POLL_INTERVAL_SECONDS="30"
ADO_AREA_FILTERS=""
ADO_TEAM_FILTERS=""

# Runtime paths.
ADO_RUNTIME_DIR="runtime"
ADO_YAML_OUTPUT_DIR="runtime/ado-work-items"
ADO_PROCESSED_STORE_PATH="runtime/ado-processed-work-items.json"

# Legacy host env var used only by deprecated work-item helper commands.
ADO_WORK_ITEMS_AZURE_DEVOPS_PAT=""

# Optional repo source metadata that workflow packs can bind into
# effect:issue:upsert-ado-proxy.repo_source.
# ADO_REPO_PATH="/path/to/local/repo"

# Fetch retry policy for transient Azure DevOps HTTP failures.
ADO_FETCH_RETRY_COUNT="2"
ADO_FETCH_RETRY_BACKOFF_SECONDS="2"

# Work item comment capture written into the generated issue YAML.
ADO_INCLUDE_COMMENTS="true"
ADO_COMMENTS_MAX_COUNT="20"
ADO_COMMENT_TEXT_MAX_CHARS="4000"
