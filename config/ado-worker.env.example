# Azure DevOps backlog polling worker configuration.

# Required Azure DevOps settings.
ADO_ORGANIZATION_URL="https://dev.azure.com/your-org"
ADO_PROJECT="your-project"

# Name of the host environment variable that stores your Azure DevOps PAT.
# The PAT itself should be exported separately (for example: export AZURE_DEVOPS_PAT=...).
ADO_PAT_ENV_VAR_NAME="AZURE_DEVOPS_PAT"

# Polling cadence and optional scope filters.
ADO_POLL_INTERVAL_SECONDS="30"
ADO_AREA_FILTERS=""
ADO_TEAM_FILTERS=""

# Runtime paths.
ADO_RUNTIME_DIR="runtime"
ADO_YAML_OUTPUT_DIR="runtime/ado-work-items"
ADO_PROCESSED_STORE_PATH="runtime/ado-processed-work-items.json"

# VM setup orchestration.
ADO_PROJECT_OR_SOLUTION="/path/to/project-or-solution.slnx"
# Optional override if different from ADO_PROJECT_OR_SOLUTION.
# ADO_PREWARM_TARGET="/path/to/project-or-solution.slnx"
ADO_SETUP_ISSUE_VM_SCRIPT="scripts/setup_issue_vm.sh"
# Optional guest toolchain bootstraps passed to setup_issue_vm.sh.
ADO_BOOTSTRAP_DOTNET="true"
ADO_BOOTSTRAP_NUGET="true"
ADO_BOOTSTRAP_MSSQL="true"
# Required when ADO_BOOTSTRAP_MSSQL=true. The worker also accepts
# MSSQL_SA_PASSWORD for compatibility with the CLI/admin paths.
ADO_MSSQL_SA_PASSWORD=""
# Optional host directory copied into /var/opt/mssql/init. If present, init.sql
# from that directory is executed after the guest-local SQL Server instance starts.
# ADO_MSSQL_INIT_ROOT="/path/to/mssql-init"
ADO_BOOTSTRAP_PLAYWRIGHT="false"
ADO_BOOTSTRAP_FRONTEND_DEPS="false"
# Optional override for remote repo-source snapshots. When omitted, setup_issue_vm.sh
# uses the local repo-source checkout automatically.
# ADO_FRONTEND_HOST_CHECKOUT="/path/to/local/repo"
# Required when ADO_BOOTSTRAP_FRONTEND_DEPS=true. Comma-separated install roots inside
# the host checkout, each already containing package.json and node_modules.
# ADO_FRONTEND_INSTALL_ROOTS="/path/to/local/repo/Src/Clients,/path/to/local/repo/Src/Clients/AdminClient"
ADO_SETUP_TIMEOUT_SECONDS="1800"
ADO_SETUP_CONCURRENCY_LIMIT="1"
ADO_SETUP_LOCK_PATH="runtime/setup-issue-vm.lock"

# Optional setup_issue_vm.sh passthrough arguments.
# ADO_REPO_PATH="/path/to/local/repo"
# ADO_SESSION_ID="session-123"
# ADO_VM_USER="agent"

# Fetch retry policy for transient Azure DevOps HTTP failures.
ADO_FETCH_RETRY_COUNT="2"
ADO_FETCH_RETRY_BACKOFF_SECONDS="2"

# Work item comment capture written into the generated issue YAML.
ADO_INCLUDE_COMMENTS="true"
ADO_COMMENTS_MAX_COUNT="20"
ADO_COMMENT_TEXT_MAX_CHARS="4000"
