# Azure DevOps backlog polling worker configuration.

# Required Azure DevOps settings.
ADO_ORGANIZATION_URL="https://dev.azure.com/your-org"
ADO_PROJECT="your-project"

# Name of the host environment variable that stores your Azure DevOps PAT.
# The PAT itself should be exported separately (for example: export AZURE_DEVOPS_PAT=...).
ADO_PAT_ENV_VAR_NAME="AZURE_DEVOPS_PAT"

# Polling cadence and optional scope filters.
ADO_POLL_INTERVAL_SECONDS="30"
ADO_AREA_FILTERS=""
ADO_TEAM_FILTERS=""

# Runtime paths.
ADO_RUNTIME_DIR="runtime"
ADO_YAML_OUTPUT_DIR="runtime/ado-work-items"
ADO_PROCESSED_STORE_PATH="runtime/ado-processed-work-items.json"

# VM setup orchestration.
ADO_PROJECT_OR_SOLUTION="/path/to/project-or-solution.slnx"
# Optional override if different from ADO_PROJECT_OR_SOLUTION.
# ADO_PREWARM_TARGET="/path/to/project-or-solution.slnx"
ADO_SETUP_ISSUE_VM_SCRIPT="scripts/setup_issue_vm.sh"
# The worker invokes setup with: --dotnet --nuget --mssql <issue-yaml> <project-or-solution> ...
ADO_SETUP_TIMEOUT_SECONDS="1800"
ADO_SETUP_CONCURRENCY_LIMIT="1"
ADO_SETUP_LOCK_PATH="runtime/setup-issue-vm.lock"

# Optional setup_issue_vm.sh passthrough arguments.
# ADO_REPO_PATH="/path/to/local/repo"
# ADO_SESSION_ID="session-123"
# ADO_VM_USER="agent"

# Fetch retry policy for transient Azure DevOps HTTP failures.
ADO_FETCH_RETRY_COUNT="2"
ADO_FETCH_RETRY_BACKOFF_SECONDS="2"
