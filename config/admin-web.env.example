# Admin web listener.
ADMIN_WEB_HOST="127.0.0.1"
ADMIN_WEB_PORT="8100"

# Admin web auth. Keep active password/session secrets outside the checkout,
# for example in /etc/evander/local-secrets.env loaded by the systemd unit.
EVANDER_ADMIN_WEB_AUTH_MODE="local_password"
# In local_password mode, this seeds the first local owner when runtime/admin-web.db
# has no users and remains a break-glass credential. Additional local users and
# password resets are managed in Admin Web Users & Groups.
EVANDER_ADMIN_WEB_USERNAME="admin"
EVANDER_ADMIN_WEB_PASSWORD=""
EVANDER_ADMIN_WEB_SESSION_SECRET=""
EVANDER_ADMIN_WEB_SESSION_TTL_SECONDS="43200"
EVANDER_ADMIN_WEB_COOKIE_SECURE="false"

# Optional Admin Web branding. Logo values may be absolute URLs, in-app paths,
# data:image URLs, or paths relative to EVANDER_ADMIN_WEB_BRANDING_ASSET_DIR.
# Relative asset paths are served under /api/admin/branding/assets/...
# EVANDER_ADMIN_WEB_PAGE_TITLE="Evander Admin"
# EVANDER_ADMIN_WEB_HEADER_TITLE="EVANDER"
# EVANDER_ADMIN_WEB_HEADER_TITLE_VISIBLE="false"
# EVANDER_ADMIN_WEB_HEADER_LOGO_SIZE="wordmark"
# EVANDER_ADMIN_WEB_BRANDING_ASSET_DIR="frontend/workflow-editor/branding"
# EVANDER_ADMIN_WEB_PRODUCT_LOGO_LIGHT_URL="evander-logo-light.png"
# EVANDER_ADMIN_WEB_PRODUCT_LOGO_DARK_URL="evander-logo-dark.png"
# EVANDER_ADMIN_WEB_PRODUCT_LOGO_ALT="Evander Logo"
# EVANDER_ADMIN_WEB_COMPANY_LOGO_LIGHT_URL="qss-light.png"
# EVANDER_ADMIN_WEB_COMPANY_LOGO_DARK_URL="qss-dark.png"
# EVANDER_ADMIN_WEB_COMPANY_LOGO_ALT="Quinth Software Solutions"
# Optional override when the header logo differs from the product logo.
# EVANDER_ADMIN_WEB_HEADER_LOGO_LIGHT_URL="header-light.png"
# EVANDER_ADMIN_WEB_HEADER_LOGO_DARK_URL="header-dark.png"
# EVANDER_ADMIN_WEB_HEADER_LOGO_ALT="Admin header logo"

# Optional workflow event machine ingress. Comma-separate source-name:token entries.
# EVANDER_WORKFLOW_EVENT_MACHINE_TOKENS="azure-devops-demo-environment-pipeline:replace-with-random-token"

# Azure SSO mode settings. Required only when EVANDER_ADMIN_WEB_AUTH_MODE="azure_sso".
# EVANDER_ADMIN_WEB_AZURE_TENANT_ID=""
# EVANDER_ADMIN_WEB_AZURE_CLIENT_ID=""
# EVANDER_ADMIN_WEB_AZURE_CLIENT_SECRET=""
# EVANDER_ADMIN_WEB_AZURE_REDIRECT_URI=""
# EVANDER_ADMIN_WEB_PUBLIC_BASE_URL="https://admin.example.com"
# Used for approval deep links in notifications and Azure SSO redirects.
# EVANDER_ADMIN_WEB_AZURE_AUTHORITY_BASE_URL="https://login.microsoftonline.com"
# First-run bootstrap only: imported as admin users when runtime/admin-web-users.json is missing or empty.
# EVANDER_ADMIN_WEB_AZURE_ALLOWED_USERS="operator@example.com"
# EVANDER_ADMIN_WEB_AZURE_POST_LOGIN_REDIRECT="/"
