# Admin web listener.
ADMIN_WEB_HOST="0.0.0.0"
ADMIN_WEB_PORT="8100"

# Admin web auth. For shared-user deployments, do not leave this at "none".
AGENT_SANDBOX_ADMIN_WEB_AUTH_MODE="local_password"
AGENT_SANDBOX_ADMIN_WEB_USERNAME="admin"
AGENT_SANDBOX_ADMIN_WEB_PASSWORD="replace-with-real-password"
AGENT_SANDBOX_ADMIN_WEB_SESSION_SECRET="replace-with-random-secret"
AGENT_SANDBOX_ADMIN_WEB_SESSION_TTL_SECONDS="43200"
AGENT_SANDBOX_ADMIN_WEB_COOKIE_SECURE="false"

# Azure SSO mode settings. Required only when AGENT_SANDBOX_ADMIN_WEB_AUTH_MODE="azure_sso".
# AGENT_SANDBOX_ADMIN_WEB_AZURE_TENANT_ID=""
# AGENT_SANDBOX_ADMIN_WEB_AZURE_CLIENT_ID=""
# AGENT_SANDBOX_ADMIN_WEB_AZURE_CLIENT_SECRET=""
# AGENT_SANDBOX_ADMIN_WEB_AZURE_REDIRECT_URI=""
# AGENT_SANDBOX_ADMIN_WEB_PUBLIC_BASE_URL="https://admin.example.com"
# AGENT_SANDBOX_ADMIN_WEB_AZURE_AUTHORITY_BASE_URL="https://login.microsoftonline.com"
# First-run bootstrap only: imported as admin users when runtime/admin-web-users.json is missing or empty.
# AGENT_SANDBOX_ADMIN_WEB_AZURE_ALLOWED_USERS="operator@example.com"
# AGENT_SANDBOX_ADMIN_WEB_AZURE_POST_LOGIN_REDIRECT="/"
