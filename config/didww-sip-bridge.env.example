# Host/port for the local bridge API consumed by phone_call_backend=openai_realtime_didww.
DIDWW_SIP_BRIDGE_HOST=127.0.0.1
DIDWW_SIP_BRIDGE_PORT=11888

# The bridge API requires this bearer token. Store the actual secret in secrets.env.
DIDWW_SIP_BRIDGE_TOKEN_ENV=DIDWW_SIP_BRIDGE_TOKEN

# Optional inbound listener for fixed routes. Leave disabled unless this bridge should accept
# inbound Asterisk StasisStart events and provision calls through the gateway.
DIDWW_SIP_BRIDGE_ENABLE_INBOUND_PHONE_CALLS=false
DIDWW_SIP_BRIDGE_INBOUND_GATEWAY_URL=http://127.0.0.1:8000
DIDWW_SIP_BRIDGE_INBOUND_GATEWAY_TOKEN_ENV=VOICE_MEDIA_CONTROLLER_TOKEN

# OpenAI Realtime configuration. Store OPENAI_API_KEY in secrets.env.
OPENAI_REALTIME_API_KEY_ENV=OPENAI_API_KEY
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_API_BASE_URL=https://api.openai.com/v1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_IDLE_TIMEOUT_MS=10000
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-4o-transcribe
# Built-in input noise reduction. near_field is the handset default; use far_field for
# speakerphone, headset, or room audio. disabled omits the setting entirely.
OPENAI_REALTIME_INPUT_NOISE_REDUCTION_TYPE=near_field
# Keep bridge-controlled barge-in with server VAD by default. These numeric values are tuned
# for a quieter call-center-style experience than the API defaults.
OPENAI_REALTIME_TURN_DETECTION_TYPE=server_vad
OPENAI_REALTIME_VAD_THRESHOLD=0.70
OPENAI_REALTIME_VAD_PREFIX_PADDING_MS=300
OPENAI_REALTIME_VAD_SILENCE_DURATION_MS=800

# Asterisk ARI configuration. Store ASTERISK_ARI_PASSWORD in secrets.env.
ASTERISK_ARI_URL=http://127.0.0.1:8088/ari
ASTERISK_ARI_USER=evander
ASTERISK_ARI_PASSWORD_ENV=ASTERISK_ARI_PASSWORD
ASTERISK_ARI_APP=evander_didww

# Asterisk PJSIP trunk configuration. This produces PJSIP/{number}@didww by default.
ASTERISK_PJSIP_ENDPOINT=didww
ASTERISK_ENDPOINT_TEMPLATE=PJSIP/{number}@{trunk}

# RTP ExternalMedia settings used between Asterisk and the Python bridge.
DIDWW_SIP_BRIDGE_EXTERNAL_MEDIA_HOST=127.0.0.1
DIDWW_SIP_BRIDGE_RTP_BIND_HOST=127.0.0.1
DIDWW_SIP_BRIDGE_RTP_PORT_MIN=41000
DIDWW_SIP_BRIDGE_RTP_PORT_MAX=41100
DIDWW_SIP_BRIDGE_RTP_PAYLOAD_TYPE=8
DIDWW_SIP_BRIDGE_MEDIA_FORMAT=alaw
DIDWW_SIP_BRIDGE_SAMPLE_RATE_HZ=8000
DIDWW_SIP_BRIDGE_FRAME_DURATION_MS=20

DIDWW_SIP_BRIDGE_CALL_TIMEOUT_SECONDS=45
DIDWW_SIP_BRIDGE_MAX_CALL_SECONDS=1800
DIDWW_SIP_BRIDGE_REQUEST_TIMEOUT_SECONDS=15
DIDWW_SIP_BRIDGE_MAX_CONCURRENT_CALLS=4

# Async origin-agent delegation polling for the Realtime query_origin_agent tool.
DIDWW_SIP_BRIDGE_VOICE_QUERY_POLL_INTERVAL_SECONDS=1
# Shorter caller-facing patience window before the bridge speaks a fallback; the backend
# query deadline remains controlled by DIDWW_SIP_BRIDGE_VOICE_QUERY_TIMEOUT_SECONDS.
DIDWW_SIP_BRIDGE_VOICE_QUERY_CALLER_PATIENCE_SECONDS=18
DIDWW_SIP_BRIDGE_VOICE_QUERY_TIMEOUT_SECONDS=90

# Delayed bridge-controlled barge-in. OpenAI Realtime VAD remains enabled, but the bridge decides
# when a caller interruption is substantive enough to cancel assistant audio.
DIDWW_SIP_BRIDGE_BARGE_IN_DELAY_MS=700
# Fade the queued RTP tail instead of hard-cutting it after a confirmed barge-in cancel. Set to 0
# to disable the taper for rollback or tests.
DIDWW_SIP_BRIDGE_BARGE_IN_FADE_MS=120
# Optional automatic hangup after an assistant goodbye. Leave at 0 to disable.
DIDWW_SIP_BRIDGE_GOODBYE_IDLE_HANGUP_SECONDS=0
DIDWW_SIP_BRIDGE_BACKCHANNEL_MAX_WORDS=3
# Exact backchannels are matched first; minor ASR corruption falls back to the fuzzy threshold.
# If a cancel already happened, the bridge queues a resume response instead of waiting for idle.
DIDWW_SIP_BRIDGE_BACKCHANNEL_FUZZY_THRESHOLD=0.84
DIDWW_SIP_BRIDGE_BACKCHANNEL_PHRASES=ok,okay,yep,yup,right,sure,uh-huh,mhm,mm-hmm,yeah,yes,good,great,thanks,thank you
