# Required for Azure DevOps PR feedback replies exposed by the gateway.
AZURE_DEVOPS_PR_PAT=

# Optional fallback for signed control-plane download links posted by teams_post_file
# for non-image artifacts. Prefer durable provider config when possible.
# EVANDER_COMMUNICATION_ARTIFACT_PUBLIC_BASE_URL="https://admin.example.com"
#
# Store EVANDER_COMMUNICATION_ARTIFACT_LINK_SECRET in repo-root secrets.env
# instead of this file so both gateway and Admin Web services load the same secret.
