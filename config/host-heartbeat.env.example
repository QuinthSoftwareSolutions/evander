# Copy to config/host-heartbeat.env and adjust values as needed.
AGENT_SANDBOX_CONFIG=config/gateway.yaml
HOST_HEARTBEAT_LOG_LEVEL=INFO
HOST_HEARTBEAT_POLL_INTERVAL_SECONDS=30
HOST_HEARTBEAT_JITTER_SECONDS=5
HOST_HEARTBEAT_COOLDOWN_SECONDS=60
HOST_HEARTBEAT_HTTP_TIMEOUT_SECONDS=30
HOST_HEARTBEAT_LOCK_PATH=runtime/host-heartbeat.lock
HOST_HEARTBEAT_SESSION_COOLDOWN_PATH=runtime/host-heartbeat-session-cooldown.json
HOST_HEARTBEAT_STREAM_CONFLICT_POLICY=fanout
# Retry/backoff for automatic service restarts is controlled by systemd:
# Restart=on-failure and RestartSec=5 in systemd/agent-sandbox-host-heartbeat.service.template.
