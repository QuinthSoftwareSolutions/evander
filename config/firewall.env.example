# Host TCP ports reachable from guests:
# 22    host SSH / Git remotes
# 8000  MCP gateway
# 11434 OpenAI-compatible LLM relay
# 11666 NuGet relay
# 11777 HTTP target relay
# 8081  Nexus package cache for PyPI/npm when enabled
# 3142  apt-cacher-ng relay for worker apt provisioning when enabled
ALLOWED_TCP_PORTS="22 8000 11434 11666 11777 8081 3142"
