# Bind the proxy only to an address reachable from trusted worker hosts.
EVANDER_CODEX_EGRESS_PROXY_HOST=127.0.0.1
EVANDER_CODEX_EGRESS_PROXY_PORT=11889

# Space- or comma-separated client CIDRs. Keep this limited to worker host addresses;
# container traffic reaches the control plane after worker-host source NAT.
EVANDER_CODEX_EGRESS_PROXY_ALLOWED_CLIENT_CIDRS="127.0.0.1/32"

# Space- or comma-separated HTTPS CONNECT destination rules.
EVANDER_CODEX_EGRESS_PROXY_ALLOWED_HOSTS="auth.openai.com api.openai.com chatgpt.com *.openai.com *.chatgpt.com"
