AGENT_SANDBOX_GIT_ROOT=/home/jonathan/agent-sandbox/git-remotes
AGENT_SANDBOX_GIT_HOST=192.168.250.1
AGENT_SANDBOX_GIT_USER=jonathan
AGENT_SANDBOX_GIT_SSH_ALIAS=agent-sandbox-git-host
# Optional: Azure DevOps PAT used when origin points at Azure DevOps.
AZURE_DEVOPS_PAT=
# Optional: alternate env var name for the PAT above.
AGENT_SANDBOX_AZURE_DEVOPS_PAT_ENV=AZURE_DEVOPS_PAT
# Optional: notes ref consumed by post-receive PR automation.
AGENT_SANDBOX_PR_NOTES_REF=refs/notes/agent-pr
# Optional: host markdown file prepended to automated PR bodies.
AGENT_SANDBOX_PR_FIXED_BODY_FILE=
# Optional: max bytes retained in composed PR body.
AGENT_SANDBOX_PR_BODY_MAX_BYTES=60000
# Optional: shell command run on the host when an agent push is promoted.
# It receives AGENT_NOTIFICATION_TITLE and AGENT_NOTIFICATION_BODY.
AGENT_SANDBOX_NOTIFY_COMMAND=
